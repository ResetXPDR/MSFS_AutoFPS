<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style project so the installer builds with plain `dotnet build` (no VS / .NET Framework
    Developer Pack needed). It deliberately stays on .NET Framework 4.8, which ships with Windows,
    because its job is to install the .NET 10 Desktop Runtime the app itself needs.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Installer</RootNamespace>
    <AssemblyName>Installer</AssemblyName>
    <StartupObject>Installer.App</StartupObject>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <AppProject>..\MSFS_AutoFPS\MSFS_AutoFPS.csproj</AppProject>
    <!-- No trailing backslash: it would escape the closing quote in the Exec command line -->
    <AppPublishDir>$(MSBuildProjectDirectory)\obj\AppPackage\$(Configuration)</AppPublishDir>
    <AppPackageZip>$(MSBuildProjectDirectory)\obj\AppPackage\AppPackage-$(Configuration).zip</AppPackageZip>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplies the net48 reference assemblies so no Developer Pack has to be installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-order only: makes a solution build finish the app before BuildAppPackage publishes it -->
    <ProjectReference Include="$(AppProject)" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <EmbeddedResource Include="MSFS2020_AutoFPS.config" LogicalName="Installer.MSFS2020_AutoFPS.config" />
    <None Remove="*.pfx" />
  </ItemGroup>

  <!--
    Publishes the app (framework-dependent) and zips it into AppPackage.zip, which is embedded
    as "Installer.AppPackage.zip" and extracted by InstallerFunctions into %appdata%\MSFS_AutoFPS\bin.
  -->
  <!-- Skipped inside WPF's temporary *_wpftmp markup-compile project, which would otherwise publish concurrently -->
  <Target Name="BuildAppPackage" AfterTargets="ResolveProjectReferences" Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <RemoveDir Directories="$(AppPublishDir)" />
    <Exec Command="dotnet publish &quot;$(AppProject)&quot; -c $(Configuration) -o &quot;$(AppPublishDir)&quot; --nologo -v q" />
    <ZipDirectory SourceDirectory="$(AppPublishDir)" DestinationFile="$(AppPackageZip)" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(AppPackageZip)" LogicalName="Installer.AppPackage.zip" />
    </ItemGroup>
  </Target>

</Project>
