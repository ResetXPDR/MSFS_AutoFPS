<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy brush keys still read by MainWindow code-behind (ThemeTextBrush, ThemeInputBgBrush...),
     re-pointed at Fluent dark values so code-set colours blend with the WPF-UI theme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#00000000" />
  <SolidColorBrush x:Key="GroupBorderBrush" Color="#19000000" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="TextForegroundBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FF2C2C2C" />
  <SolidColorBrush x:Key="PopupHoverBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#19000000" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C5FFFFFF" />
  <SolidColorBrush x:Key="AccentBrandBrush" Color="#FF22D3EE" />
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#0FFFFFFF" />
</ResourceDictionary>
