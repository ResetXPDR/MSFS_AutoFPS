<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy brush keys still read by MainWindow code-behind (ThemeTextBrush, ThemeInputBgBrush...),
     re-pointed at Fluent light values so code-set colours blend with the WPF-UI theme. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#00000000" />
  <SolidColorBrush x:Key="GroupBorderBrush" Color="#0F000000" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="TextForegroundBrush" Color="#E4000000" />
  <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFF9F9F9" />
  <SolidColorBrush x:Key="PopupHoverBrush" Color="#09000000" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9E000000" />
  <SolidColorBrush x:Key="AccentBrandBrush" Color="#FF0E7490" />
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#09000000" />
</ResourceDictionary>
