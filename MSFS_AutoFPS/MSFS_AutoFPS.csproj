<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source reconstructed (ILSpy 11.2) from the official MSFS_AutoFPS v0.5.5.0 release binary
    (MSFS_AutoFPS.zip, upstream commit 90c3277). Upstream author: ResetXPDR (MIT licence).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <StartupObject>MSFS_AutoFPS.App</StartupObject>
    <RootNamespace>MSFS_AutoFPS</RootNamespace>
    <AssemblyName>MSFS_AutoFPS</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <!-- Decompiled code: silence style/nullable noise that is not actionable -->
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0649;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="icon.ico" />
    <EmbeddedResource Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="MSFS_Icon.png" />
    <Resource Include="AutoFPS.png" />
    <Resource Include="RTSS_Icon.png" />
    <Resource Include="OFXR_armed.png" />
    <Resource Include="VectorXR.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions taken from the v0.5.5.0 release MSFS_AutoFPS.deps.json -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.0.124" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
    <Reference Include="RTSSSharedMemoryNET">
      <HintPath>RTSSSharedMemoryNET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="exe.xml" CopyToOutputDirectory="Always" />
    <None Update="MSFS_AutoFPS.config" CopyToOutputDirectory="Always" />
    <None Update="MSFS2020_AutoFPS.config" CopyToOutputDirectory="Always" />
    <None Update="MSFS2024_AutoFPS.config" CopyToOutputDirectory="Always" />
    <None Update="README.md" CopyToOutputDirectory="Always" />
    <None Update="SimConnect.dll" CopyToOutputDirectory="Always" />
    <None Update="GpuzShMem.x64.dll" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
