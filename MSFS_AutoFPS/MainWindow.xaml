                  <FrameworkElement.ToolTip>
                    <ToolTip>
                      <TextBlock>Auto Method<LineBreak />FPS Sensitivity: recommended; preferred for FPS caps (use Fixed Target FPS).<LineBreak />FPS Tolerance (legacy): for older profiles or stutter cases.<LineBreak />Auto TLOD: DynamicLOD-style auto TLOD.<LineBreak />FPS Cap (legacy): compatibility only; Sensitivity + Fixed Target FPS preferred.<LineBreak /><LineBreak />Legacy modes may not receive future enhancements.</TextBlock>
                    </ToolTip>
                  </FrameworkElement.ToolTip>
                  <ComboBoxItem Content="FPS Sensitivity" IsSelected="True" />
                  <ComboBoxItem Content="FPS Tolerance (legacy)" />
                  <ComboBoxItem Content="Auto TLOD" />
                  <ComboBoxItem Content="FPS Cap (legacy)" />
