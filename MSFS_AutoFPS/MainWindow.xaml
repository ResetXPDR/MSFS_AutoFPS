<?xml version="1.0" encoding="utf-8"?>
<!--
  Fluent (WPF-UI) main window.
  Every named control and event handler of the original v0.5.5 layout is kept (code-behind addresses them by name);
  only their arrangement and styling changed. Layout: title bar, left navigation rail, three pages
  (Overview, Tuning, Settings) switched by MainWindow.Fluent.cs.
-->
<ui:FluentWindow x:Class="MSFS_AutoFPS.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:MSFS_AutoFPS"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 x:Name="AutoFPS" Title="MSFS_AutoFPS" Icon="/icon.ico"
                 Width="880" Height="720" MinWidth="620" MinHeight="420"
                 Topmost="True" ShowInTaskbar="True" ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown" Closing="Window_Closing" StateChanged="Window_StateChanged">
  <FrameworkElement.ContextMenu>
    <ContextMenu>
      <MenuItem Name="mnuToggleTitleBar" Header="Hide Title Bar" Click="mnuToggleTitleBar_Click" />
      <MenuItem Header="Minimise" Click="mnuMinimise_Click" />
      <MenuItem Name="mnuCloseToTray" Header="Close to Tray" Visibility="Collapsed" Click="mnuCloseToTray_Click" />
      <Separator />
      <MenuItem Header="Exit" Click="mnuExit_Click" />
    </ContextMenu>
  </FrameworkElement.ContextMenu>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <!-- Swapped light/dark at runtime by SetTheme(); holds the legacy brush keys code-behind reads -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MSFS_AutoFPS;component/Themes/ThemeDark.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- ===== Implicit control tweaks (based on the WPF-UI Fluent styles) ===== -->
      <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
      </Style>
      <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinWidth" Value="0" />
        <!-- WPF-UI default is 11,5,11,6 which indents boxes relative to labels -->
        <Setter Property="Padding" Value="0,5,4,6" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="MaxWidth" Value="460" />
      </Style>

      <!-- ===== Layout building blocks ===== -->
      <Style x:Key="PageTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
      </Style>
      <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <Style x:Key="CardHint" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,-6,0,12" />
      </Style>
      <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,14,16,10" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>
      <Style x:Key="Row" TargetType="{x:Type WrapPanel}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Orientation" Value="Horizontal" />
      </Style>
      <Style x:Key="RowStack" TargetType="{x:Type StackPanel}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Orientation" Value="Horizontal" />
      </Style>
      <!-- Metric tile inside the Sim Values card -->
      <Style x:Key="Tile" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
      </Style>
      <Style x:Key="MetricCaption" TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style x:Key="MetricValue" TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="MetricValueSmall" TargetType="{x:Type Label}" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <!-- Connection status chip: the dot takes the label Foreground set by code (green/red/orange) -->
      <Style x:Key="StatusChip" TargetType="{x:Type Label}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Label}">
              <Border CornerRadius="13" Padding="10,4,12,4" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
                  <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- GroupBox rendered as a Fluent card (gpboxConnectionStatus / gpboxSimValues keep their GroupBox type) -->
      <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GroupBox}">
              <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                  <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,12" TextElement.FontSize="14" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <ContentPresenter />
                </DockPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Navigation rail item -->
      <Style x:Key="NavItem" TargetType="{x:Type RadioButton}">
        <Setter Property="GroupName" Value="nav" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Grid Background="Transparent">
                <Border x:Name="bg" CornerRadius="4" Background="Transparent" />
                <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource AccentBrandBrush}" Visibility="Collapsed" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                  <Setter TargetName="pill" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PageScroller" TargetType="{x:Type ScrollViewer}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="24,16,20,12" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="titleBar" Grid.Row="0" Title="{Binding Title, ElementName=AutoFPS}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/AutoFPS.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ===== Navigation rail ===== -->
      <DockPanel Grid.Column="0" Margin="8,4,8,8" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="navOverview" Style="{StaticResource NavItem}" Tag="pageOverview" IsChecked="True" ToolTip="Overview" Checked="NavItem_Checked">
            <ui:SymbolIcon Symbol="Gauge24" FontSize="20" />
          </RadioButton>
          <RadioButton x:Name="navTuning" Style="{StaticResource NavItem}" Tag="pageTuning" ToolTip="Tuning (expert options)" Checked="NavItem_Checked">
            <ui:SymbolIcon Symbol="Options24" FontSize="20" />
          </RadioButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <RadioButton x:Name="navSettings" Style="{StaticResource NavItem}" Tag="pageSettings" ToolTip="Settings" Checked="NavItem_Checked">
            <ui:SymbolIcon Symbol="Settings24" FontSize="20" />
          </RadioButton>
        </StackPanel>
      </DockPanel>

      <!-- ===== Content layer ===== -->
      <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}">
        <Grid>

          <!-- =========================== OVERVIEW =========================== -->
          <ScrollViewer x:Name="pageOverview" Style="{StaticResource PageScroller}">
            <StackPanel>
              <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />

              <GroupBox Name="gpboxConnectionStatus" Header="Connection status">
                <Border Background="#00FFFFFF" MouseLeave="PerfOpt_MouseLeave">
                  <StackPanel Orientation="Vertical">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Label Name="lblConnStatMSFS" Style="{StaticResource StatusChip}" Foreground="#FFFF0000" MouseEnter="PerfOpt_MouseEnter">MSFS</Label>
                      <Label Name="lblConnStatSimConnect" Style="{StaticResource StatusChip}" Foreground="#FFFF0000">SimConnect</Label>
                      <Label Name="lblConnStatSession" Style="{StaticResource StatusChip}" Foreground="#FFFF0000">Session</Label>
                      <Label Name="lblConnStatWidget" Style="{StaticResource StatusChip}" Foreground="#FFFF0000">Widget</Label>
                      <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <CheckBox Name="chkPerfOptEnabled" Content="" Margin="0" IsChecked="True" MouseEnter="PerfOpt_MouseEnter" Click="chkPerfOptEnabled_Click">
                          <FrameworkElement.ToolTip>
                            <TextBlock>Enable MSFS performance optimisations<LineBreak />(can improve or reduce performance depending on system;<LineBreak />monitor performance after enabling)</TextBlock>
                          </FrameworkElement.ToolTip>
                        </CheckBox>
                        <Label Name="lblPerfOptEnabled" Content="Performance optimiser" MouseEnter="PerfOpt_MouseEnter" />
                      </StackPanel>
                    </WrapPanel>
                    <WrapPanel Name="stkpnlPerfOptDetails" Visibility="Collapsed" Orientation="Horizontal" Margin="0,12,0,0">
                      <CheckBox Name="chkPerfOptAffinity" Content="Physical cores" Click="chkPerfOptAffinity_Click" />
                      <CheckBox Name="chkPerfOptPriority" Content="" Margin="0,0,4,0" Click="chkPerfOptPriority_Click" />
                      <ComboBox Name="cbPerfOptPriority" ToolTip="Sets the MSFS process priority to AboveNormal or High" SelectionChanged="cbPerfOptPriority_SelectionChanged">
                        <ComboBoxItem Content="AboveNormal" />
                        <ComboBoxItem Content="High" IsSelected="True" />
                      </ComboBox>
                      <Label Name="lblPerfOptPriority" Content="Priority" Margin="0,0,16,0" />
                      <CheckBox Name="chkPerfOptPowerPlan" Content="Best power plan" Click="chkPerfOptPowerPlan_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </GroupBox>

              <GroupBox Name="gpboxSimValues">
                <HeaderedContentControl.Header>
                  <DockPanel>
                    <Image Name="imgSimHeaderIcon" Visibility="Collapsed" Source="/MSFS_Icon.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Default MSFS settings" />
                    <Image Name="imgSimHeaderIcon2" Visibility="Collapsed" Source="/AutoFPS.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="AutoFPS-controlled MSFS settings" />
                    <TextBlock Text="Sim values" VerticalAlignment="Center" />
                  </DockPanel>
                </HeaderedContentControl.Header>
                <!-- Code-behind toggles rows 2..5 (settings reduction details) by Grid.Row: keep this Grid shape -->
                <Grid Margin="0,0,-8,-8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}">
                    <StackPanel>
                      <Label Name="lblSimFPSType" Style="{StaticResource MetricCaption}">FPS+:</Label>
                      <StackPanel Orientation="Horizontal">
                        <Label Name="lblSimFPS" Style="{StaticResource MetricValue}">n/a</Label>
                        <Grid VerticalAlignment="Center">
                          <Image Name="imgSimFPSRTSS" Width="18" Height="18" ToolTip="FPS source: RTSS. Click to change to MSFS" Visibility="Hidden" Source="/RTSS_Icon.png" Cursor="Hand" MouseLeftButtonDown="imgSimFPS_Click" />
                          <Image Name="imgSimFPSMSFS" Width="18" Height="18" ToolTip="FPS source: MSFS. Click to change to RTSS (must be running)" Visibility="Hidden" Source="/MSFS_Icon.png" Cursor="Hand" MouseLeftButtonDown="imgSimFPS_Click" />
                          <Image Name="imgSimFPSOFXR" Width="18" Height="18" ToolTip="FPS source: OFXR" Visibility="Hidden" Source="/OFXR_armed.png" MouseLeftButtonDown="imgSimFPS_Click" />
                          <Image Name="imgSimFPSVXR" Width="18" Height="18" ToolTip="FPS source: VXR" Visibility="Hidden" Source="/VectorXR.png" MouseLeftButtonDown="imgSimFPS_Click" />
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}">
                    <StackPanel>
                      <Label Name="lblSimTLODlbl" Style="{StaticResource MetricCaption}">TLOD:</Label>
                      <Label Name="lblSimTLOD" Style="{StaticResource MetricValue}">n/a</Label>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel>
                      <Label Name="lblSimOLODlbl" Style="{StaticResource MetricCaption}">OLOD:</Label>
                      <Label Name="lblSimOLOD" Style="{StaticResource MetricValue}">n/a</Label>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}">
                    <StackPanel>
                      <Label Style="{StaticResource MetricCaption}">AGL (ft)</Label>
                      <Label Name="lblPlaneAGL" Style="{StaticResource MetricValue}">n/a</Label>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                    <StackPanel>
                      <Label Style="{StaticResource MetricCaption}">Vertical speed (fpm)</Label>
                      <Label Name="lblPlaneVS" Style="{StaticResource MetricValue}">n/a</Label>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel>
                      <Label Name="lblSimReduce" Style="{StaticResource MetricCaption}" MouseEnter="lblSimReduce_MouseEnter" MouseLeave="lblSimReduce_MouseLeave">Clouds:</Label>
                      <Label Name="lblSimReduce2" Style="{StaticResource MetricValue}" MouseEnter="lblSimReduce2_MouseEnter" MouseLeave="lblSimReduce_MouseLeave">n/a</Label>
                    </StackPanel>
                  </Border>
                  <!-- Settings reduction details (MSFS 2024), shown by code on hover / when active -->
                  <Border Grid.Row="2" Grid.Column="0" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Style="{StaticResource MetricCaption}">Clouds</Label><Label Name="lblReduceCloudQ" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="2" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Style="{StaticResource MetricCaption}">Trees</Label><Label Name="lblReduceTrees" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="2" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Style="{StaticResource MetricCaption}">RT shadows</Label><Label Name="lblReduceRTShadows" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="3" Grid.Column="0" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Style="{StaticResource MetricCaption}">Terrain shadows</Label><Label Name="lblReduceTShadows" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="3" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Style="{StaticResource MetricCaption}">Buildings</Label><Label Name="lblReduceBldings" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="3" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Style="{StaticResource MetricCaption}">Displacement map</Label><Label Name="lblReduceDispMap" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="4" Grid.Column="0" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Style="{StaticResource MetricCaption}">Off-screen pre-cache</Label><Label Name="lblReduceOSTPCache" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="4" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Style="{StaticResource MetricCaption}">Plants</Label><Label Name="lblReducePlants" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="4" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Style="{StaticResource MetricCaption}">Grass</Label><Label Name="lblReduceGrass" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="5" Grid.Column="0" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Name="lblReducePkdAcQ2" Style="{StaticResource MetricCaption}">PkdAcQ:</Label><Label Name="lblReducePkdAcQ" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                  <Border Grid.Row="5" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource Tile}"><StackPanel><Label Name="lblReduceAcTrafQ2" Style="{StaticResource MetricCaption}">AcTrafQ:</Label><Label Name="lblReduceAcTrafQ" Style="{StaticResource MetricValueSmall}">n/a</Label></StackPanel></Border>
                </Grid>
              </GroupBox>

              <StackPanel Name="stkpnlGeneral" Orientation="Vertical">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Flight" Style="{StaticResource CardTitle}" />
                    <WrapPanel Style="{StaticResource Row}">
                      <StackPanel Name="stkTargetFPS" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Name="cbTargetFPSOption" MinWidth="96" SelectedIndex="0" SelectionChanged="cbTargetFPSOption_SelectionChange">
                          <FrameworkElement.ToolTip>
                            <TextBlock>Target FPS option<LineBreak />Manual: User choice (default)<LineBreak />Auto: AutoFPS chooses automatically<LineBreak />Fixed: FPS stays at the system-set<LineBreak />fixed value; requires matching it<LineBreak /><LineBreak />Orange highlight means a Fixed FPS<LineBreak />was detected that does not match your<LineBreak />Target FPS. If this is a permanent<LineBreak />setup, adjust Target FPS to match.</TextBlock>
                          </FrameworkElement.ToolTip>
                          <ComboBoxItem Content="Manual" />
                          <ComboBoxItem Content="Auto" />
                          <ComboBoxItem Content="Fixed" IsSelected="True" />
                        </ComboBox>
                        <Label Name="lblTargetFPS1" Content="Target" />
                        <ComboBox Name="cbTargetFPSType" MinWidth="96" SelectionChanged="cbTargetFPSType_SelectionChange">
                          <FrameworkElement.ToolTip>
                            <TextBlock>Graphics mode for Target FPS selection<LineBreak />NFR (Native Frame Rate) is initial default<LineBreak />Defaults to last used graphics mode on startup<LineBreak />Man FG enables manual frame‑generation settings<LineBreak />All others auto detect when graphics mode changes<LineBreak />Manual select allows editing non‑active graphics mode settings<LineBreak />(background changes to orange)</TextBlock>
                          </FrameworkElement.ToolTip>
                        </ComboBox>
                        <ComboBox Name="cbManFgMultiplier" SelectedIndex="0" Visibility="Collapsed" SelectionChanged="cbManFgMultiplier_SelectionChange">
                          <FrameworkElement.ToolTip>
                            <TextBlock>Manual frame‑generation multiplier settings<LineBreak />Auto returns to NFR and disables manual FG<LineBreak />FG 2X–8X apply fixed frame‑generation ratios<LineBreak />DynFG uses 1X (NFR) when MSFS is the FPS source<LineBreak />and variable multipliers when RTSS is the FPS source<LineBreak />Used only when Man FG is the active graphics mode</TextBlock>
                          </FrameworkElement.ToolTip>
                          <ComboBoxItem Content="Auto" />
                          <ComboBoxItem Content="FG 2X " IsSelected="True" />
                          <ComboBoxItem Content="FG 3X " />
                          <ComboBoxItem Content="FG 4X " />
                          <ComboBoxItem Content="FG 5X " />
                          <ComboBoxItem Content="FG 6X " />
                          <ComboBoxItem Content="FG 7X " />
                          <ComboBoxItem Content="FG 8X " />
                          <ComboBoxItem Content="DynFG" />
                        </ComboBox>
                        <Label Name="lblTargetFPS2" Content="FPS" />
                      </StackPanel>
                      <TextBox Name="txtTargetFPS" MinWidth="72" FontSize="16" FontWeight="SemiBold" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp">
                        <FrameworkElement.ToolTip>
                          <TextBlock>Enter a target FPS achievable by your system<LineBreak />for the selected graphics mode.<LineBreak /><LineBreak />If using frame generation, this is the target for<LineBreak />the rendered FPS AFTER frame generation is applied,<LineBreak />EXCEPT when using DynFG with MSFS as the FPS source,<LineBreak />which targets the rendered FPS BEFORE frame generation is applied.<LineBreak /></TextBlock>
                        </FrameworkElement.ToolTip>
                      </TextBox>
                    </WrapPanel>
                    <WrapPanel Style="{StaticResource Row}">
                      <Label Content="Flight type" />
                      <ComboBox Name="cbActiveProfile" MinWidth="140" IsTextSearchEnabled="False" IsEditable="False" SelectionChanged="cbActiveProfile_SelectionChange" MouseDoubleClick="cbActiveProfile_MouseDoubleClick" Loaded="cbActiveProfile_Loaded">
                        <FrameworkElement.ToolTip>
                          <TextBlock>Select a flight type applicable to your current flight.<LineBreak />VFR: General Aviation flights in regional areas<LineBreak />IFR: Airliner flights in urban areas<LineBreak />(Expert) Double click to edit profile names<LineBreak />↔ Indicates Non-VR/VR pairing<LineBreak />Use xX to enable Sim Rate pairing</TextBlock>
                        </FrameworkElement.ToolTip>
                      </ComboBox>
                      <CheckBox Name="chkUseExpertOptions" Content="Expert options" ToolTip="See readme and tooltips for detailed descriptions of the expert settings this enables" Margin="8,0,12,0" Click="chkUseExpertOptions_Click" />
                      <CheckBox Name="chkVRAMPlus" Visibility="Collapsed" Content="VRAM+" ToolTipService.ShowOnDisabled="True" Click="chkVRAMPlus_Click">
                        <FrameworkElement.ToolTip>
                          <TextBlock>Hold/reduce key settings if VRAM<LineBreak />use is nearing full capacity<LineBreak />(Global, including Non-Expert)</TextBlock>
                        </FrameworkElement.ToolTip>
                      </CheckBox>
                      <Button Name="btnReset" Content="_Reset" Visibility="Collapsed" Margin="8,0,8,0" ToolTip="Reset TLOD, Clouds, Auto Target FPS and graphics mode detection to initial state." Click="btnReset_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Status line (update notices, DynSet) -->
              <Border Style="{StaticResource Card}" Padding="16,10">
                <StackPanel Name="stkStatusRow" Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <StackPanel Name="stkDynSet" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Name="btnDynSet" Content="DynSet" ToolTip="MSFS dynamic settings options." Margin="0,0,4,0" Click="btnDynSet_Click" />
                    <StackPanel Name="stkDynSetChange" Orientation="Vertical" VerticalAlignment="Center">
                      <Button Name="btnDynSetPlus" Content="+" Width="22" Height="16" FontSize="10" Padding="0" Margin="0,0,0,1" Click="btnDynSetPlus_Click" />
                      <Button Name="btnDynSetMinus" Content="−" Width="22" Height="16" FontSize="10" Padding="0" Margin="0" Click="btnDynSetMinus_Click" />
                    </StackPanel>
                  </StackPanel>
                  <Label Name="lblStatusMessage" MinWidth="50" TextBlock.TextAlignment="Left" Content="" />
                  <TextBlock Name="lblappUrl" Visibility="Collapsed" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://github.com/dankocrnkovic/MSFS_AutoFPS/releases/latest" RequestNavigate="Hyperlink_RequestNavigate">here</Hyperlink>
                  </TextBlock>
                  <TextBlock Name="lblappUrlTestVersion" Visibility="Collapsed" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://github.com/dankocrnkovic/MSFS_AutoFPS/releases" RequestNavigate="Hyperlink_RequestNavigate">here</Hyperlink>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- =========================== TUNING =========================== -->
          <ScrollViewer x:Name="pageTuning" Style="{StaticResource PageScroller}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Tuning" Style="{StaticResource PageTitle}" />
              <Border Style="{StaticResource Card}">
                <Border.Visibility>
                  <Binding ElementName="stkpnlExpertSettings" Path="Visibility" Converter="{x:Static local:FluentUi.InverseVisibility}" />
                </Border.Visibility>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="LockClosed24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Turn on Expert options on the Overview page to tune TLOD, OLOD, clouds and settings reduction." />
                </StackPanel>
              </Border>

              <StackPanel Name="stkpnlExpertSettings" Orientation="Vertical">
                <!-- TLOD automation -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="TLOD automation" Style="{StaticResource CardTitle}" />
                    <WrapPanel Style="{StaticResource Row}">
                      <Label Content="Auto method" />
                      <ComboBox Name="cbTLODAutoMethod" MinWidth="170" SelectedIndex="0" SelectionChanged="cbTLODAutoMethod_SelectionChanged">
                        <FrameworkElement.ToolTip>
                          <ToolTip>
                            <TextBlock>Auto Method<LineBreak />FPS Sensitivity: recommended; preferred for FPS caps (use Fixed Target FPS).<LineBreak />FPS Tolerance (legacy): for older profiles or stutter cases.<LineBreak />Auto TLOD: DynamicLOD-style auto TLOD.<LineBreak />FPS Cap (legacy): compatibility only; Sensitivity + Fixed Target FPS preferred.<LineBreak /><LineBreak />Legacy modes may not receive future enhancements.</TextBlock>
                          </ToolTip>
                        </FrameworkElement.ToolTip>
                        <ComboBoxItem Content="FPS Sensitivity" IsSelected="True" />
                        <ComboBoxItem Content="FPS Tolerance (legacy)" />
                        <ComboBoxItem Content="Auto TLOD" />
                        <ComboBoxItem Content="FPS Cap (legacy)" />
                      </ComboBox>
                      <Label Name="lblTLODAuto1" Content="LOD Step" Margin="8,0,8,0" />
                      <TextBox Name="txtFPSTolerance" ToolTip="TLOD responsiveness to FPS variances" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <CheckBox Name="chkSpikeProtect" Visibility="Collapsed" ToolTip="Auto reduce TLOD Max when periodic FPS spikes detected" ToolTipService.ShowOnDisabled="True" Margin="8,0,4,0" Click="chkSpikeProtect_Click" />
                      <Label Name="lblSpikeProtect" Visibility="Collapsed" Content="⚡Prot" />
                    </WrapPanel>
                    <WrapPanel Name="stkpnlSpikeDetect" Visibility="Collapsed" Style="{StaticResource Row}">
                      <Label Content="⚡Mult" />
                      <TextBox Name="txtSpikeThresholdMultiplier" ToolTip="Sets the spike threshold as a ratio of the median frame time, making detection more or less sensitive" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <Button Name="btnSpikeRec" Content="⚡Rec " ToolTip="Record last 10s of frame times to log file." Click="btnSpikeRec_Click" />
                      <Label Content="⚡Status:" />
                      <Label Name="lblSpikeDetectProtStatus" Content="" MinWidth="50" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Altitude bands -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Altitude bands" Style="{StaticResource CardTitle}" />
                    <WrapPanel Style="{StaticResource Row}">
                      <Label Name="lblTLODMin" Content="TLOD Base Min" MinWidth="104" />
                      <TextBox Name="txtMinTLod" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <Label Content="@" />
                      <TextBox Name="txtAltTLODBase" MinWidth="80" ToolTip="TLOD Min will be locked below this altitude" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <Label Content="ft" Margin="0,0,16,0" />
                      <ComboBox Name="cbTLODBaseOption" SelectedIndex="0" SelectionChanged="cbTLODBaseOption_SelectionChange">
                        <FrameworkElement.ToolTip>
                          <TextBlock>TLOD Base option<LineBreak />Fixed: TLOD Base stays at the system-set fixed value (default)<LineBreak />Extra: Additional TLOD Base with good performance conditions<LineBreak />Free: TLOD may range between Min and Max, depending on performance conditions</TextBlock>
                        </FrameworkElement.ToolTip>
                        <ComboBoxItem Content="Fixed" IsSelected="True" />
                        <ComboBoxItem Content="Extra" />
                        <ComboBoxItem Content="Free" />
                      </ComboBox>
                      <CheckBox Name="chkMinTLODExtra" Visibility="Collapsed" ToolTip="Extra TLOD Base with good performance conditions" Click="chkMinTLODExtra_Click" />
                      <CheckBox Name="chkTLODBaseMinus" Visibility="Collapsed" Content="Extra" ToolTip="Extra TLOD Base below Alt TLOD Top with good performance conditions" Click="chkTLODBaseMinus_Click" />
                      <ComboBox Name="cbMinTLODExtraCapMult" SelectedIndex="0" SelectionChanged="cbMinTLODExtraCapMult_SelectionChange">
                        <FrameworkElement.ToolTip>
                          <TextBlock>Multiple of TLOD Base Min</TextBlock>
                        </FrameworkElement.ToolTip>
                        <ComboBoxItem Content="×1.5" />
                        <ComboBoxItem Content="×2" IsSelected="True" />
                        <ComboBoxItem Content="×2.5" />
                        <ComboBoxItem Content="×3" />
                        <ComboBoxItem Content="×3.5" />
                        <ComboBoxItem Content="×4" />
                      </ComboBox>
                      <CheckBox Name="chkStartTLODExtraAtMax" Visibility="Collapsed" Content="Start Max" IsChecked="True" Click="chkStartTLODExtraAtMax_Click">
                        <FrameworkElement.ToolTip>
                          <TextBlock>Start with TLOD Extra at maximum.<LineBreak />WARNING: Initial performance may<LineBreak />be sub-optimal when enabled.</TextBlock>
                        </FrameworkElement.ToolTip>
                      </CheckBox>
                    </WrapPanel>
                    <WrapPanel Style="{StaticResource Row}">
                      <Label Name="lblTLODMax" Content="TLOD Top Max" MinWidth="104" />
                      <TextBox Name="txtMaxTLod" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <Label Content="@" />
                      <TextBox Name="txtAltTLODTop" MinWidth="80" ToolTip="Determines what altitude TLOD will start reducing towards TLOD Min" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <Label Content="ft" Margin="0,0,16,0" />
                      <CheckBox Name="chkTLODExtraMtns" ToolTip="Extra TLOD Top Max in high terrain areas" Margin="0,0,4,0" Click="chkTLODExtraMtns_Click" />
                      <Label Name="lblTLODExtraMtns" Content="Mountains" Margin="0,0,16,0" />
                      <CheckBox Name="chkMaxTLODExtra" Visibility="Collapsed" IsEnabled="false" ToolTip="Extra TLOD Top with good performance conditions" Margin="0,0,4,0" Click="chkMaxTLODExtra_Click" />
                      <Label Name="lblMaxTLODExtra" Visibility="Collapsed" Content="Extra" />
                      <ComboBox Name="cbMaxTLODExtraCapMult" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="cbMaxTLODExtraCapMult_SelectionChange">
                        <FrameworkElement.ToolTip>
                          <TextBlock>Multiple of TLOD Top Max</TextBlock>
                        </FrameworkElement.ToolTip>
                        <ComboBoxItem Content="×1.5" />
                        <ComboBoxItem Content="×2" IsSelected="True" />
                        <ComboBoxItem Content="×2.5" />
                        <ComboBoxItem Content="×3" />
                        <ComboBoxItem Content="×3.5" />
                        <ComboBoxItem Content="×4" />
                      </ComboBox>
                      <Label Name="lblNightMode" Content="Night" />
                      <ComboBox Name="cbNightMode" SelectionChanged="cbNightMode_SelectionChanged">
                        <FrameworkElement.ToolTip>
                          <TextBlock>Night optimization mode: Halve TLOD, reduce cloud quality, or both</TextBlock>
                        </FrameworkElement.ToolTip>
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="TLOD÷2" />
                        <ComboBoxItem Content="Clds-2" />
                        <ComboBoxItem Content="Both" />
                      </ComboBox>
                    </WrapPanel>
                    <WrapPanel Name="stkpnlTLODExtraMtns" Visibility="Visible" Style="{StaticResource Row}">
                      <Label Content="Mountains +" MinWidth="104" />
                      <TextBox Name="txtTLODExtraMtnsAmount" ToolTip="Additional TLOD Max in mountainous areas" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <Label Content="@" />
                      <TextBox Name="txtTLODExtraMtnsTriggerAlt" MinWidth="80" ToolTip="Minimum terrain altitude at which additional TLOD Max will activate" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <Label Content="ft" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Clouds (hidden when code collapses all of its rows, e.g. MSFS 2024) -->
                <Border Style="{StaticResource Card}">
                  <Border.Visibility>
                    <MultiBinding Converter="{x:Static local:FluentUi.AnyVisible}">
                      <Binding ElementName="stkpnlCloudQualityOptions" Path="Visibility" />
                      <Binding ElementName="stkpnlCloudQualityOptions2" Path="Visibility" />
                      <Binding ElementName="stkpnlCloudQualityOptions3" Path="Visibility" />
                    </MultiBinding>
                  </Border.Visibility>
                  <StackPanel>
                    <TextBlock Text="Clouds" Style="{StaticResource CardTitle}" />
                    <WrapPanel Name="stkpnlCloudQualityOptions" Style="{StaticResource Row}">
                      <CheckBox Name="chkDecCloudQ" Content="Decrease cloud quality" ToolTip="Reduce cloud quality by one level if activation condition is met" Margin="0,0,24,0" Click="chkDecCloudQ_Click" />
                      <Label Name="lblCloudMethod" Content="Activation method" />
                      <ComboBox Name="cbCloudMethod" MinWidth="110" SelectedIndex="0" SelectionChanged="cbCloudMethod_SelectionChange">
                        <ComboBoxItem Content="TLOD" IsSelected="True" />
                        <ComboBoxItem Content="GPU Load" />
                      </ComboBox>
                    </WrapPanel>
                    <WrapPanel Name="stkpnlCloudQualityOptions2" Style="{StaticResource Row}">
                      <Label Name="lblCloudRecoveryTLOD" Content="Recovery TLOD" />
                      <TextBox Name="txtCloudRecoveryTLOD" ToolTip="Minimum TLOD required to cancel cloud quality reduction" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <Label Name="lblCloudPlus" Content="+" Margin="0,0,4,0" />
                      <CheckBox Name="chkCloudRecoveryPlus" ToolTip="+ for relative rather than absolute cloud recovery TLOD " Click="chkCloudRecoveryPlus_Click" Checked="chkCloudRecoveryPlus_Checked" />
                    </WrapPanel>
                    <WrapPanel Name="stkpnlCloudQualityOptions3" Style="{StaticResource Row}">
                      <Label Name="lblCloudDecRec" Content="Decrease / recover @" />
                      <TextBox Name="txtCloudDecreaseGPUPct" ToolTip="Minimum GPU load required to decrease cloud quality reduction" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <TextBox Name="txtCloudRecoverGPUPct" ToolTip="Maximum GPU load required to cancel cloud quality reduction" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                      <Label Name="lblCloudGPUPercent" Content="GPU %" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Objects LOD -->
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Objects LOD" Style="{StaticResource CardTitle}" />
                    <WrapPanel Name="stkCustomAutoOLOD" Style="{StaticResource Row}">
                      <CheckBox Name="chkCustomAutoOLOD" Content="Auto OLOD" ToolTip="Adjusts OLOD based on an altitude band" Margin="0,0,24,0" Click="chkCustomAutoOLOD_Click" />
                      <CheckBox Name="chkOLODPanelHide" Content="Hide OLOD settings" ToolTip="Adjusts OLOD based on an altitude band" Click="chkOLODPanelHide_Click" />
                      <CheckBox Name="chkVRAMPlus2" Visibility="Collapsed" Content="VRAM+" ToolTipService.ShowOnDisabled="True" Click="chkVRAMPlus2_Click">
                        <FrameworkElement.ToolTip>
                          <TextBlock>Hold/reduce key settings if VRAM<LineBreak />use is nearing full capacity<LineBreak />(Global, including Non-Expert)</TextBlock>
                        </FrameworkElement.ToolTip>
                      </CheckBox>
                    </WrapPanel>
                    <StackPanel Name="stkpnlCustomAutoOLOD" Orientation="Vertical" Visibility="Visible">
                      <WrapPanel Style="{StaticResource Row}">
                        <Label Content="OLOD Base" MinWidth="104" />
                        <TextBox Name="txtOLODAtBase" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                        <Label Content="@" />
                        <TextBox Name="txtAltOLODBase" MinWidth="80" ToolTip="OLOD @ Base will be locked below this altitude" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                        <Label Content="ft" />
                      </WrapPanel>
                      <WrapPanel Style="{StaticResource Row}">
                        <Label Content="OLOD Top" MinWidth="104" />
                        <TextBox Name="txtOLODAtTop" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                        <Label Content="@" />
                        <TextBox Name="txtAltOLODTop" MinWidth="80" ToolTip="OLOD @ top will be locked above this altitude" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp" />
                        <Label Content="ft" />
                      </WrapPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Settings reduction (MSFS 2024) -->
                <StackPanel Name="stkpnlAutoReduceSettings" Visibility="Visible" Orientation="Vertical">
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="Settings reduction" Style="{StaticResource CardTitle}" />
                      <WrapPanel Style="{StaticResource Row}">
                        <CheckBox Name="chkAutoReduceSettings" Content="Auto reduce settings" ToolTip="Reduce key settings if target FPS can't be achieved" Click="chkAutoReduceSettings_Click" />
                        <CheckBox Name="chkIncCloudQ" Content="Auto increase clouds" ToolTipService.ShowOnDisabled="True" Click="chkIncCloudQ_Click">
                          <FrameworkElement.ToolTip>
                            <TextBlock>Increase cloud quality by one level<LineBreak />in favourable performance conditions</TextBlock>
                          </FrameworkElement.ToolTip>
                        </CheckBox>
                        <Label Name="lblVRAMPlus" Visibility="Collapsed" Content="VRAM+" />
                        <ComboBox Name="cbVRAMPlus" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="cbVRAMPlus_SelectionChange">
                          <FrameworkElement.ToolTip>
                            <TextBlock>Hold/reduce key settings if VRAM<LineBreak />use is nearing full capacity<LineBreak />Set = use auto reduce settings<LineBreak />(Global)</TextBlock>
                          </FrameworkElement.ToolTip>
                          <ComboBoxItem Content="Off" />
                          <ComboBoxItem Content="Max" IsSelected="True" />
                          <ComboBoxItem Content="Set" />
                        </ComboBox>
                      </WrapPanel>
                      <StackPanel Name="stkpnlAutoReduceSettings2" Visibility="Visible" Orientation="Vertical">
                        <WrapPanel Style="{StaticResource Row}">
                          <Label Content="Max levels" />
                          <ComboBox Name="cbReductionSettingsMaxLevels" Margin="0,0,16,0" ToolTip="Maximum number of levels settings can reduce by" SelectedIndex="0" SelectionChanged="cbReductionSettingsMaxLevels_SelectionChange">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                          </ComboBox>
                          <Label Content="Floor" />
                          <ComboBox Name="cbReductionSettingsFloor" Margin="0,0,16,0" ToolTip="Lowest quality level reduction allowable for quality settings" SelectedIndex="0" SelectionChanged="cbReductionSettingsFloor_SelectionChange">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="Lowest" IsSelected="True" />
                            <ComboBoxItem Content="Medium" />
                            <ComboBoxItem Content="High" />
                          </ComboBox>
                          <Label Content="Recover" />
                          <ComboBox Name="cbReductionSettingsRecoveryAlt" ToolTip="Lowest altitude at which settings reduction will attempt to recover" SelectedIndex="0" SelectionChanged="cbReductionSettingsRecoveryAlt_SelectionChange">
                            <ComboBoxItem Content="Ground" />
                            <ComboBoxItem Content="Alt TLOD Base" />
                            <ComboBoxItem Content="Alt TLOD Top" IsSelected="True" />
                          </ComboBox>
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                          <Label Content="Reduction suite" MouseEnter="cbReductionSettingsSuite_MouseEnter" MouseLeave="cbReductionSettingsSuite_MouseLeave" />
                          <ComboBox Name="cbReductionSettingsSuite" MinWidth="240" ToolTip="Settings that will be automatically reduced" SelectedIndex="0" SelectionChanged="cbReductionSettingsSuite_SelectionChange" MouseEnter="cbReductionSettingsSuite_MouseEnter" MouseLeave="cbReductionSettingsSuite_MouseLeave">
                            <ComboBoxItem Content="LODs 50% Only" />
                            <ComboBoxItem Content="LODs, Clouds, Trees, RT Shadows" IsSelected="True" />
                            <ComboBoxItem Content="Full Reduction Suite" />
                            <ComboBoxItem Content="Custom" />
                          </ComboBox>
                        </WrapPanel>
                      </StackPanel>
                      <StackPanel Name="stkpnlSettingsReduction" Visibility="Collapsed" Orientation="Vertical" MouseEnter="cbReductionSettingsSuite_MouseEnter" MouseLeave="cbReductionSettingsSuite_MouseLeave">
                        <UniformGrid Columns="4" Margin="0,4,0,4">
                          <CheckBox Name="chkReduceCloudQ" Content="Clouds" ToolTip="Volumetric Clouds" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="chkReduceCloudQ_Click" />
                          <CheckBox Name="chkReduceTrees" Content="Trees" ToolTip="Trees" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="chkReduceTrees_Click" />
                          <CheckBox Name="chkReduceRTShadows" Content="RT shadows" ToolTip="Raytraced Shadows" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="chkReduceRTShadows_Click" />
                          <CheckBox Name="chkReduceTShadows" Content="Terrain shadows" ToolTip="Terrain Shadows" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="chkReduceTShadows_Click" />
                          <CheckBox Name="chkReduceBldings" Content="Buildings" ToolTip="Buildings" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="chkReduceBldings_Click" />
                          <CheckBox Name="chkReduceDispMap" Content="Displacement" ToolTip="Displacement Mapping" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="chkReduceDispMap_Click" />
                          <CheckBox Name="chkReduceOSTPCache" Content="Pre-caching" ToolTip="Off Screen Terrain Pre-Caching" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="chkReduceOSTPCache_Click" />
                          <CheckBox Name="chkReducePlants" Content="Plants" ToolTip="Plants" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="chkReducePlants_Click" />
                          <CheckBox Name="chkReduceGrass" Content="Grass" ToolTip="Grass" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="chkReduceGrass_Click" />
                          <CheckBox Name="chkReducePkdAcQ" Content="Parked aircraft" ToolTip="Parked Aircraft Quantity" Margin="0,0,8,8" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="chkReducePkdAcQ_Click" />
                          <CheckBox Name="chkReduceAcTrafQ" Content="Air traffic" ToolTip="Aircraft Traffic Quantity" Margin="0,0,8,8" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="chkReduceAcTrafQ_Click" />
                        </UniformGrid>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- =========================== SETTINGS =========================== -->
          <ScrollViewer x:Name="pageSettings" Style="{StaticResource PageScroller}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Window" Style="{StaticResource CardTitle}" />
                  <WrapPanel Style="{StaticResource Row}">
                    <CheckBox Name="chkDarkMode" Content="Dark theme" Margin="0,0,24,0" Click="chkDarkMode_Click">
                      <FrameworkElement.ToolTip>
                        <TextBlock>Enable or disable dark mode</TextBlock>
                      </FrameworkElement.ToolTip>
                    </CheckBox>
                    <CheckBox Name="chkOnTop" Content="Always on top" ToolTip="Show MSFS_AutoFPS on top of all other windows" Click="chkOnTop_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                  <WrapPanel Style="{StaticResource Row}">
                    <ComboBox Name="cbUpdateOption" MinWidth="200" SelectedIndex="0" SelectionChanged="cbUpdateOption_SelectionChange">
                      <FrameworkElement.ToolTip>
                        <TextBlock>Choose Silent (no prompts), Prompted (previously Auto),<LineBreak />Show (available updates and links), or Mandatory‑only</TextBlock>
                      </FrameworkElement.ToolTip>
                      <ComboBoxItem Content="Silent Updates" />
                      <ComboBoxItem Content="Prompted Updates" IsSelected="True" />
                      <ComboBoxItem Content="Show Updates" />
                      <ComboBoxItem Content="Mandatory Updates Only " />
                    </ComboBox>
                    <ComboBox Name="cbUpdateChannel" MinWidth="110" SelectionChanged="cbUpdateChannel_SelectionChanged">
                      <FrameworkElement.ToolTip>
                        <TextBlock>Choose Release (stable), RC+ (release candidates or higher),<LineBreak />Test+ (test builds or higher), or Exp+ (experimental builds or higher)</TextBlock>
                      </FrameworkElement.ToolTip>
                      <ComboBoxItem Content="Release" IsSelected="True" />
                      <ComboBoxItem Content="RC+" />
                      <ComboBoxItem Content="Test+" />
                      <ComboBoxItem Content="Exp+" />
                    </ComboBox>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Diagnostics" Style="{StaticResource CardTitle}" />
                  <CheckBox Name="chkLOGPlus" Content="Extended logging (Log+)" Click="chkLOGPlus_Click">
                    <FrameworkElement.ToolTip>
                      <TextBlock>Additional logging to assist with<LineBreak />troubleshooting and development</TextBlock>
                    </FrameworkElement.ToolTip>
                  </CheckBox>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="About" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="txtAboutVersion" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                  <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    Fork of MSFS_AutoFPS by ResetXPDR, based on the work of muumimorko and Fragtality. MIT licence.
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
