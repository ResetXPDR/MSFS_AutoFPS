<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MSFS_AutoFPS.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:MSFS_AutoFPS" x:Name="AutoFPS" Title="MSFS_AutoFPS" Opacity="0.88" Topmost="True" WindowStyle="SingleBorderWindow" ShowInTaskbar="true" Background="{DynamicResource WindowBackgroundBrush}" ResizeMode="CanMinimize" SizeToContent="WidthAndHeight" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown" MouseDoubleClick="AutoFPS_DoubleClick" Closing="Window_Closing" StateChanged="Window_StateChanged">
  <FrameworkElement.ContextMenu>
    <ContextMenu>
      <MenuItem Name="mnuToggleTitleBar" Header="Hide Title Bar" Click="mnuToggleTitleBar_Click" />
      <MenuItem Header="Minimise" Click="mnuMinimise_Click" />
      <MenuItem Name="mnuCloseToTray" Header="Close to Tray" Visibility="Collapsed" Click="mnuCloseToTray_Click" />
      <Separator />
      <MenuItem Header="Exit" Click="mnuExit_Click" />
    </ContextMenu>
  </FrameworkElement.ContextMenu>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MSFS_AutoFPS;component/Themes/ThemeLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="{x:Type GroupBox}" TargetType="{x:Type GroupBox}">
        <Setter Property="BorderBrush" Value="{DynamicResource GroupBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        <Setter Property="HeaderTemplate">
          <Setter.Value>
            <DataTemplate>
              <TextBlock FontWeight="DemiBold" Foreground="{DynamicResource TextForegroundBrush}" Text="{Binding}" />
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type Label}" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      </Style>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        <Setter Property="TextBoxBase.CaretBrush" Value="{DynamicResource TextForegroundBrush}" />
      </Style>
      <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GroupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      </Style>
      <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5,3" />
        <Style.Triggers>
          <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
            <Setter Property="Background" Value="{DynamicResource PopupHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type ContextMenu}" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GroupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="3">
                <StackPanel IsItemsHost="True" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type MenuItem}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" CornerRadius="3" Padding="12,5" Margin="1">
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Control.Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="MenuItem.IsHighlighted" Value="True">
                  <Setter TargetName="border" Value="{DynamicResource PopupHoverBrush}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type Separator}" TargetType="{x:Type Separator}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Separator}">
              <Border Height="1" Background="{DynamicResource GroupBorderBrush}" Margin="4,3" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Name="chkBorder" MinWidth="14" Height="14" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0">
                  <Path Name="chkPath" Data="M2.5,6.5 L5.5,9.5 L11.5,2.5" Stroke="{DynamicResource TextForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                </Border>
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="chkPath" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox Name="viewBox" Stretch="None" StretchDirection="DownOnly" HorizontalAlignment="Stretch">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="6,6,6,2">
      <GroupBox Name="gpboxConnectionStatus" BorderThickness="1" Margin="0,0,0,6" BorderBrush="{DynamicResource GroupBorderBrush}" Header="Connection Status">
        <Border Background="#00FFFFFF" MouseLeave="PerfOpt_MouseLeave">
          <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Label Name="lblPerfOptEnabled" Height="40" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="0,0,-2,0">+</Label>
              <CheckBox Name="chkPerfOptEnabled" VerticalContentAlignment="Center" Height="24" MaxHeight="24" MinHeight="24" Content="" Margin="0,0,0,0" Background="{DynamicResource InputBackgroundBrush}" IsChecked="True" MouseEnter="PerfOpt_MouseEnter" Click="chkPerfOptEnabled_Click">
                <FrameworkElement.ToolTip>
                  <TextBlock>Enable MSFS performance optimisations<LineBreak />(can improve or reduce performance depending on system;<LineBreak />monitor performance after enabling)</TextBlock>
                </FrameworkElement.ToolTip>
              </CheckBox>
              <Label Name="lblConnStatMSFS" Height="40" VerticalContentAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#FFFF0000" Padding="0,0,16,0" MouseEnter="PerfOpt_MouseEnter">MSFS</Label>
              <Label Name="lblConnStatSimConnect" Height="40" VerticalContentAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#FFFF0000" Padding="8,0,16,0">SimConnect</Label>
              <Label Name="lblConnStatSession" Height="40" VerticalContentAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#FFFF0000" Padding="8,0,16,0">Session</Label>
              <Label Name="lblConnStatWidget" Height="40" VerticalContentAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#FFFF0000" Padding="8,0,16,0">Widget</Label>
            </StackPanel>
            <StackPanel Name="stkpnlPerfOptDetails" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-4,0,10">
              <CheckBox Name="chkPerfOptAffinity" Content="Physical Cores" Height="24" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,12,0" Background="{DynamicResource InputBackgroundBrush}" Click="chkPerfOptAffinity_Click" />
              <CheckBox Name="chkPerfOptPriority" Content="" Height="24" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,4,0" Background="{DynamicResource InputBackgroundBrush}" Click="chkPerfOptPriority_Click" />
              <ComboBox Name="cbPerfOptPriority" ToolTip="Sets the MSFS process priority to AboveNormal or High" Height="24" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="3,0,0,0" Margin="-5,0,4,0" SelectionChanged="cbPerfOptPriority_SelectionChanged">
                <ComboBoxItem Content="AboveNormal" />
                <ComboBoxItem Content="High" IsSelected="True" />
              </ComboBox>
              <Label Name="lblPerfOptPriority" Content="Priority" Height="24" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="0" Margin="-2,0,12,0" />
              <CheckBox Name="chkPerfOptPowerPlan" Content="Best Power Plan" Height="24" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,0,0" Background="{DynamicResource InputBackgroundBrush}" Click="chkPerfOptPowerPlan_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </GroupBox>
      <GroupBox Name="gpboxSimValues" BorderThickness="1" Margin="0,0,0,6" BorderBrush="{DynamicResource GroupBorderBrush}">
        <HeaderedContentControl.Header>
          <DockPanel>
            <Image Name="imgSimHeaderIcon" Visibility="Collapsed" Source="/MSFS_Icon.png" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="Default MSFS settings" />
            <Image Name="imgSimHeaderIcon2" Visibility="Collapsed" Source="/AutoFPS.png" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="AutoFPS-controlled MSFS settings" />
            <TextBlock Text="Sim Values" VerticalAlignment="Center" />
          </DockPanel>
        </HeaderedContentControl.Header>
        <HeaderedContentControl.HeaderTemplate>
          <DataTemplate>
            <ContentPresenter Content="{Binding}" />
          </DataTemplate>
        </HeaderedContentControl.HeaderTemplate>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="32" Width="*" />
            <ColumnDefinition MinWidth="32" Width="*" />
            <ColumnDefinition MinWidth="32" Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Label Name="lblSimFPSType" MinWidth="60" VerticalContentAlignment="Center">FPS+:</Label>
            <Label Name="lblSimFPS" VerticalContentAlignment="Center">n/a</Label>
            <Image Name="imgSimFPSRTSS" Width="16" Height="16" ToolTip="FPS source: RTSS. Click to change to MSFS" Visibility="Hidden" VerticalAlignment="Center" Margin="5,0,0,0" Source="/RTSS_Icon.png" MouseLeftButtonDown="imgSimFPS_Click" />
            <Image Name="imgSimFPSMSFS" Width="16" Height="16" ToolTip="FPS source: MSFS. Click to change to RTSS (must be running)" Visibility="Hidden" VerticalAlignment="Center" Margin="5,0,0,0" Source="/MSFS_Icon.png" MouseLeftButtonDown="imgSimFPS_Click" />
            <Image Name="imgSimFPSOFXR" Width="16" Height="16" ToolTip="FPS source: OFXR" Visibility="Hidden" VerticalAlignment="Center" Margin="5,0,0,0" Source="/OFXR_armed.png" MouseLeftButtonDown="imgSimFPS_Click" />
            <Image Name="imgSimFPSVXR" Width="16" Height="16" ToolTip="FPS source: VXR" Visibility="Hidden" VerticalAlignment="Center" Margin="5,0,0,0" Source="/VectorXR.png" MouseLeftButtonDown="imgSimFPS_Click" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Name="lblSimTLODlbl" MinWidth="60" VerticalContentAlignment="Center">TLOD:</Label>
            <Label Name="lblSimTLOD" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Name="lblSimOLODlbl" MinWidth="60" VerticalContentAlignment="Center">OLOD:</Label>
            <Label Name="lblSimOLOD" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center" Margin="10,0,0,0">AGL:</Label>
            <Label Name="lblPlaneAGL" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center">FPM:</Label>
            <Label Name="lblPlaneVS" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Name="lblSimReduce" MinWidth="60" VerticalContentAlignment="Center" MouseEnter="lblSimReduce_MouseEnter" MouseLeave="lblSimReduce_MouseLeave">Clouds:</Label>
            <Label Name="lblSimReduce2" VerticalContentAlignment="Center" MouseEnter="lblSimReduce2_MouseEnter" MouseLeave="lblSimReduce_MouseLeave">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center" Margin="10,0,0,0">Clouds:</Label>
            <Label Name="lblReduceCloudQ" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="1" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center">Trees:</Label>
            <Label Name="lblReduceTrees" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center">RTShad:</Label>
            <Label Name="lblReduceRTShadows" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="0" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center" Margin="10,0,0,0">TShad:</Label>
            <Label Name="lblReduceTShadows" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="1" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center">Bldings:</Label>
            <Label Name="lblReduceBldings" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="2" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center">DispMap:</Label>
            <Label Name="lblReduceDispMap" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="0" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center" Margin="10,0,0,0">OSTPC:</Label>
            <Label Name="lblReduceOSTPCache" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="1" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center">Plants:</Label>
            <Label Name="lblReducePlants" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="2" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label MinWidth="60" VerticalContentAlignment="Center">Grass:</Label>
            <Label Name="lblReduceGrass" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="5" Grid.Column="0" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Name="lblReducePkdAcQ2" MinWidth="60" VerticalContentAlignment="Center" Margin="10,0,0,0">PkdAcQ:</Label>
            <Label Name="lblReducePkdAcQ" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
          <StackPanel Grid.Row="5" Grid.Column="1" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Name="lblReduceAcTrafQ2" MinWidth="60" VerticalContentAlignment="Center">AcTrafQ:</Label>
            <Label Name="lblReduceAcTrafQ" MinWidth="64" VerticalContentAlignment="Center">n/a</Label>
          </StackPanel>
        </Grid>
      </GroupBox>
      <StackPanel Name="stkpnlGeneral" Orientation="Vertical" HorizontalAlignment="Stretch">
        <GroupBox BorderThickness="1" Margin="0,0,0,6" VerticalAlignment="Stretch" BorderBrush="{DynamicResource GroupBorderBrush}" Header="General">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="369*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition MinHeight="32" Height="*" />
              <RowDefinition MinHeight="32" Height="*" />
              <RowDefinition MinHeight="32" Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0" Grid.ColumnSpan="2">
              <StackPanel Name="stkTargetFPS" Orientation="Horizontal" MinWidth="120">
                <ComboBox Name="cbTargetFPSOption" MinWidth="60" SelectedIndex="0" Background="{DynamicResource InputBackgroundBrush}" SelectionChanged="cbTargetFPSOption_SelectionChange">
                  <FrameworkElement.ToolTip>
                    <TextBlock>Target FPS option<LineBreak />Manual: User choice (default)<LineBreak />Auto: AutoFPS chooses automatically<LineBreak />Fixed: FPS stays at the system-set<LineBreak />fixed value; requires matching it<LineBreak /><LineBreak />Orange highlight means a Fixed FPS<LineBreak />was detected that does not match your<LineBreak />Target FPS. If this is a permanent<LineBreak />setup, adjust Target FPS to match.</TextBlock>
                  </FrameworkElement.ToolTip>
                  <ComboBoxItem Content="Manual" />
                  <ComboBoxItem Content="Auto" />
                  <ComboBoxItem Content="Fixed" IsSelected="True" />
                </ComboBox>
                <Label Name="lblTargetFPS1" Content="Target" />
                <ComboBox Name="cbTargetFPSType" Background="{DynamicResource InputBackgroundBrush}" SelectionChanged="cbTargetFPSType_SelectionChange">
                  <FrameworkElement.ToolTip>
                    <TextBlock>Graphics mode for Target FPS selection<LineBreak />NFR (Native Frame Rate) is initial default<LineBreak />Defaults to last used graphics mode on startup<LineBreak />Man FG enables manual frame‑generation settings<LineBreak />All others auto detect when graphics mode changes<LineBreak />Manual select allows editing non‑active graphics mode settings<LineBreak />(background changes to orange)</TextBlock>
                  </FrameworkElement.ToolTip>
                </ComboBox>
                <ComboBox Name="cbManFgMultiplier" SelectedIndex="0" Background="{DynamicResource InputBackgroundBrush}" Visibility="Collapsed" SelectionChanged="cbManFgMultiplier_SelectionChange">
                  <FrameworkElement.ToolTip>
                    <TextBlock>Manual frame‑generation multiplier settings<LineBreak />Auto returns to NFR and disables manual FG<LineBreak />FG 2X–8X apply fixed frame‑generation ratios<LineBreak />DynFG uses 1X (NFR) when MSFS is the FPS source<LineBreak />and variable multipliers when RTSS is the FPS source<LineBreak />Used only when Man FG is the active graphics mode</TextBlock>
                  </FrameworkElement.ToolTip>
                  <ComboBoxItem Content="Auto" />
                  <ComboBoxItem Content="FG 2X " IsSelected="True" />
                  <ComboBoxItem Content="FG 3X " />
                  <ComboBoxItem Content="FG 4X " />
                  <ComboBoxItem Content="FG 5X " />
                  <ComboBoxItem Content="FG 6X " />
                  <ComboBoxItem Content="FG 7X " />
                  <ComboBoxItem Content="FG 8X " />
                  <ComboBoxItem Content="DynFG" />
                </ComboBox>
                <Label Name="lblTargetFPS2" Content="FPS" />
              </StackPanel>
              <TextBox Name="txtTargetFPS" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" MaxHeight="24" MinHeight="24" MinWidth="42" Background="{DynamicResource InputBackgroundBrush}" LostFocus="TextBox_LostFocus" KeyUp="TextBox_KeyUp">
                <FrameworkElement.ToolTip>
                  <TextBlock>Enter a target FPS achievable by your system<LineBreak />for the selected graphics mode.<LineBreak /><LineBreak />If using frame generation, this is the target for<LineBreak />the rendered FPS AFTER frame generation is applied,<LineBreak />EXCEPT when using DynFG with MSFS as the FPS source,<LineBreak />which targets the rendered FPS BEFORE frame generation is applied.<LineBreak /></TextBlock>
                </FrameworkElement.ToolTip>
              </TextBox>
              <CheckBox Name="chkOnTop" VerticalContentAlignment="Center" ToolTip="Show MSFS_AutoFPS on top of all other windows" Content="On top" Margin="30,0,0,0" Background="{DynamicResource InputBackgroundBrush}" Click="chkOnTop_Click" />
              <CheckBox Name="chkDarkMode" Content="Dark" VerticalContentAlignment="Center" Margin="10,0,0,0" Background="{DynamicResource InputBackgroundBrush}" Click="chkDarkMode_Click">
                <FrameworkElement.ToolTip>
                  <TextBlock>Enable or disable dark mode</TextBlock>
                </FrameworkElement.ToolTip>
              </CheckBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Visibility="Visible" Orientation="Horizontal" Margin="0,8,0,0">
              <CheckBox Name="chkUseExpertOptions" Visibility="Visible" ToolTip="See readme and tooltips for detailed descriptions of the expert settings this enables" VerticalContentAlignment="Center" Height="24" Margin="5,0,0,0" Background="{DynamicResource InputBackgroundBrush}" Click="chkUseExpertOptions_Click">Expert</CheckBox>
              <CheckBox Name="chkLOGPlus" Content="Log+" VerticalContentAlignment="Center" Margin="10,0,0,0" Background="{DynamicResource InputBackgroundBrush}" Click="chkLOGPlus_Click">
                <FrameworkElement.ToolTip>
                  <TextBlock>Additional logging to assist with<LineBreak />troubleshooting and development</TextBlock>
                </FrameworkElement.ToolTip>
              </CheckBox>
              <Button Name="btnReset" Content="_Reset" MinWidth="42" Padding="3,1" Margin="10,0,0,0" BorderThickness="1,1,2,2" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}" ToolTip="Reset TLOD, Clouds, Auto Target FPS and graphics mode detection to initial state." Click="btnReset_Click" />
              <Label Content="Flight Type" Margin="10,0,0,0" />
              <ComboBox Name="cbActiveProfile" MinWidth="115" IsTextSearchEnabled="False" IsEditable="False" Background="{DynamicResource InputBackgroundBrush}" SelectionChanged="cbActiveProfile_SelectionChange" MouseDoubleClick="cbActiveProfile_MouseDoubleClick" Loaded="cbActiveProfile_Loaded">
                <FrameworkElement.ToolTip>
                  <TextBlock>Select a flight type applicable to your current flight.<LineBreak />VFR: General Aviation flights in regional areas<LineBreak />IFR: Airliner flights in urban areas<LineBreak />(Expert) Double click to edit profile names<LineBreak />↔ Indicates Non-VR/VR pairing<LineBreak />Use xX to enable Sim Rate pairing</TextBlock>
                </FrameworkElement.ToolTip>
              </ComboBox>
              <CheckBox Name="chkVRAMPlus" Visibility="Collapsed" VerticalContentAlignment="Center" Content="VRAM+" Padding="4,0,0,0" Margin="15,0,0,0" Background="{DynamicResource InputBackgroundBrush}" ToolTipService.ShowOnDisabled="True" Click="chkVRAMPlus_Click">
                <FrameworkElement.ToolTip>
                  <TextBlock>Hold/reduce key settings if VRAM<LineBreak />use is nearing full capacity<LineBreak />(Global, including Non-Expert)</TextBlock>
                </FrameworkElement.ToolTip>
              </CheckBox>
            </StackPanel>
            <StackPanel Name="stkStatusRow" Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
              <StackPanel Name="stkDynSet" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="btnDynSet" Content="DynSet" Margin="0,0,0,0" BorderThickness="1,1,2,2" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}" ToolTip="MSFS dynamic settings options." Click="btnDynSet_Click" />
                <StackPanel Name="stkDynSetChange" Orientation="Vertical" VerticalAlignment="Center">
                  <Button Name="btnDynSetPlus" Content="+" Width="12" Height="12" FontSize="8" Padding="0" Margin="0" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}" Click="btnDynSetPlus_Click" />
                  <Button Name="btnDynSetMinus" Content="−" Width="12" Height="12" FontSize="8" Padding="0" Margin="0" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}" Click="btnDynSetMinus_Click" />
                </StackPanel>
              </StackPanel>
              <ComboBox Name="cbUpdateOption" MinWidth="100" SelectedIndex="0" Background="{DynamicResource InputBackgroundBrush}" SelectionChanged="cbUpdateOption_SelectionChange">
                <FrameworkElement.ToolTip>
                  <TextBlock>Choose Silent (no prompts), Prompted (previously Auto),<LineBreak />Show (available updates and links), or Mandatory‑only</TextBlock>
                </FrameworkElement.ToolTip>
                <ComboBoxItem Content="Silent Updates" />
