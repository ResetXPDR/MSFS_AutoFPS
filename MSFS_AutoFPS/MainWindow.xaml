                  <ComboBoxItem Content="Fixed" IsSelected="True" />
                  <ComboBoxItem Content="Extra" />
                  <ComboBoxItem Content="Free" />
                </ComboBox>
                <CheckBox Name="chkMinTLODExtra" Visibility="Collapsed" VerticalContentAlignment="Center" ToolTip="Extra TLOD Base with good performance conditions" Margin="0,0,0,0" Background="{DynamicResource InputBackgroundBrush}" Click="chkMinTLODExtra_Click" />
                <CheckBox Name="chkTLODBaseMinus" Visibility="Collapsed" Content="Extra" VerticalContentAlignment="Center" ToolTip="Extra TLOD Base below Alt TLOD Top with good performance conditions" Margin="0,0,5,0" Background="{DynamicResource InputBackgroundBrush}" Click="chkTLODBaseMinus_Click" />
