                <Label Content="⚡Status:" Margin="0,0,0,0" />
                <Label Name="lblSpikeDetectProtStatus" Content="" Margin="-5,0,0,0" MinWidth="50" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
