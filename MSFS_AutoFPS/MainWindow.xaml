                <CheckBox Name="chkStartTLODExtraAtMax" Visibility="Collapsed" VerticalContentAlignment="Center" Content="Start Max" Margin="10,0,0,0" Background="{DynamicResource InputBackgroundBrush}" IsChecked="True" Click="chkStartTLODExtraAtMax_Click">
